# Kết nối PostgreSQL 15 (chỉ nghe localhost).
# Mật khẩu có ký tự đặc biệt (@ # : / ? % & $ ...) phải mã hoá: @ -> %40, # -> %23 ...
# Lệnh mã hoá: [uri]::EscapeDataString('mat-khau') trong PowerShell. Xem README mục 1.3.
DATABASE_URL="postgresql://postgres:MAT_KHAU@localhost:5432/spa_crm?schema=public"

# Đặt "false" CHỈ khi chạy thử bằng http qua IP khác localhost. Qua Cloudflare Tunnel luôn để true.
COOKIE_SECURE="true"

# ---- Sao lưu (chỉ lưu trên máy, không đẩy lên cloud) ----
BACKUP_PASSWORD="doi-mat-khau-nay-va-ghi-ra-giay"
# Nên đặt ở ổ đĩa KHÁC ổ cài Windows/PostgreSQL (hoặc ổ cứng gắn ngoài) để hỏng một ổ không mất cả hai.
BACKUP_DIR="D:\SpaCRM\backups"
PG_BIN="C:\Program Files\PostgreSQL\15\bin"
